---
import Layout from "@/layouts/Layout.astro";
const instagramUrl = "https://www.instagram.com/brasadrones/";
---

<Layout title="Home" showNavbar={false} showFooter={false}>
  <main class="min-h-screen bg-black text-white">
    <div class="mx-auto flex min-h-screen max-w-3xl items-center justify-center px-6 py-16">
      <a
        class="group flex flex-col items-center gap-6 rounded-[2rem] border border-white/10 bg-white/5 px-10 py-10 text-center transition hover:border-white/20 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/50"
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit brasadrones on Instagram"
      >
        <div class="flex h-28 w-28 items-center justify-center rounded-3xl bg-gradient-to-br from-[#F58529] via-[#DD2A7B] to-[#8134AF] p-4 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
          <svg aria-hidden="true" viewBox="0 0 512 512" class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="instaGradient" x1="0" y1="0" x2="512" y2="512" gradientUnits="userSpaceOnUse">
                <stop stop-color="#F58529"/>
                <stop offset="0.25" stop-color="#DD2A7B"/>
                <stop offset="0.5" stop-color="#8134AF"/>
                <stop offset="0.75" stop-color="#515BD4"/>
                <stop offset="1" stop-color="#F58529"/>
              </linearGradient>
            </defs>
            <rect x="64" y="64" width="384" height="384" rx="96" fill="url(#instaGradient)"/>
            <rect x="128" y="128" width="256" height="256" rx="64" fill="#fff"/>
            <circle cx="256" cy="256" r="80" fill="url(#instaGradient)"/>
            <circle cx="344" cy="168" r="22" fill="#fff"/>
          </svg>
        </div>
        <div>
          <h1 class="text-4xl font-semibold md:text-5xl">brasadrones</h1>
          <p class="mt-3 text-base text-gray-300 md:text-lg">Clique para saber mais sobre a BRASA.</p>
        </div>
      </a>
    </div>
  </main>
</Layout>
